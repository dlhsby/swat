# Local Claude Code agent state (worktrees, permission allowlists, etc.) —
# except skills/, which are reusable tooling worth sharing with the team.
.claude/*
!.claude/skills/

# Temp scratch prompts (planning-session inputs, not part of the repo)
prompts/

# Env files with secrets — keep only .example templates
**/.env
!**/.env.example

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~

# Local legacy DB backup tooling (operator scripts, not versioned)
legacy-db-backup/
