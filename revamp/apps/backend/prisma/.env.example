# Prisma CLI reads DATABASE_URL from this file (prisma/.env) automatically.
# Copy to prisma/.env (gitignored) for local migrate/seed/studio commands:
#   cp prisma/.env.example prisma/.env
# Must match DATABASE_URL in the repo-root .env.local.
DATABASE_URL=postgresql://swat:swat_dev_password@localhost:5432/swat?schema=public

# Required by prisma/seed.ts and migrate-legacy.ts (superadmin bootstrap password).
# Standalone `prisma db seed` / `ts-node` runs load THIS file reliably (unlike the
# repo-root .env.local, which is only loaded when cwd happens to be apps/backend) —
# keep this in sync with SUPERADMIN_PASSWORD in the repo-root .env.local.
SUPERADMIN_PASSWORD=dev-superadmin-please-change
