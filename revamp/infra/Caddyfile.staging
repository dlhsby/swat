# SWAT staging — Caddyfile (SWAT owns the TLS edge).
#
# Mounted read-only into the `caddy` service in compose.staging.yml at
# /etc/caddy/Caddyfile. SWAT is the sole tenant of its EC2 box (account
# 732343865225), so it binds 80/443 itself.
#
# History: SWAT used to be a co-tenant on the sibling project's box and shipped
# these blocks as a DROP-IN that the box's foreign Caddyfile imported. That
# coupling is gone as of the 2026-09 account migration — no conf.d copy, no
# restarting somebody else's container.
#
# UAT runs over HTTPS — bare hostnames tell Caddy to auto-provision a free
# Let's Encrypt cert and redirect HTTP->HTTPS. All three A records must already
# point at this box's Elastic IP BEFORE the first deploy, or the HTTP-01
# challenge fails and the smoke test errors on TLS. The issued certs live in the
# `caddy-data` volume — never prune it, or every deploy re-requests certs and
# eventually trips Let's Encrypt rate limits.

# API — NestJS backend. Global prefix /api/v1; /health + /health/ready are at root
# for probes; Swagger at /api/docs.
api.swat.wahyutrip.com {
	encode gzip
	reverse_proxy swat-backend:3000
}

# Web dashboard — Next.js (standalone). Default locale id-ID.
swat.wahyutrip.com {
	encode gzip
	reverse_proxy swat-web:3001
}

# Docs — public user manual (Docusaurus static site served by nginx on :80).
# No auth. The swat-docs container joins the shared `edge` network.
docs.swat.wahyutrip.com {
	encode gzip
	reverse_proxy swat-docs:80
}

# Adminer — database UI for staging support work.
#
# PUBLIC hostname, so basic auth is mandatory in front of it. The bcrypt hash is
# injected from SSM at deploy time via /opt/swat/.env (seed-env-from-ssm.sh); it is
# NOT committed, because this repo is public and a committed hash is an offline
# cracking target. Basic auth is the outer gate only — Adminer itself still demands
# the database credentials, so this is two independent secrets, not one.
#
# Retrieve the password with:
#   aws ssm get-parameter --profile dlhsby-swat-staging-cli --region ap-southeast-3 \
#     --name /swat/staging/ADMINER_BASIC_AUTH_PASSWORD --with-decryption \
#     --query Parameter.Value --output text
adminer.swat.wahyutrip.com {
	encode gzip
	basic_auth {
		swat {env.ADMINER_BASIC_AUTH_HASH}
	}
	# Adminer is a database console: never let it be framed, indexed, or referred out.
	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Robots-Tag "noindex, nofollow"
	}
	reverse_proxy swat-adminer:8080
}
